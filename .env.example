# Copy to .env and fill in. .env is gitignored — never commit a real key.
# Get a key at https://console.groq.com/keys
#
# No VITE_ prefix on purpose: VITE_ variables are inlined into the bundle and
# would be readable by anyone using the app. This one is read only by
# api/_deck.js, which runs on the server and never ships to the browser.
#
# In production set this in the Vercel dashboard, not in a file.
GROQ_API_KEY=

# Optional. Any Groq model that supports JSON mode.
GROQ_MODEL=llama-3.3-70b-versatile
